APP_NAME=Phodex Backend
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/phodex
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/phodex
REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_CHANNEL=phodex:task-events
CACHE_TTL_SECONDS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
TASK_RATE_LIMIT_PER_MINUTE=30
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080
MAX_ACTIVE_SESSIONS_PER_USER=0
MAX_CONCURRENT_TASKS_PER_USER=0

# The address your phone should use to reach this backend when it's NOT on
# the same Wi-Fi network — e.g. a Tailscale IP (http://100.x.x.x:8000) or an
# ngrok/Cloudflare Tunnel URL. Shown as a QR code at /pair for the mobile
# app's "Connect to desktop" screen to scan. Leave unset to fall back to a
# best-effort local Wi-Fi IP guess (same-network only). See README's
# "Connecting your phone remotely" section.
PUBLIC_BASE_URL=

# Real push notifications (approval needed, task completed/failed) via the
# FCM HTTP v1 API. Generate a service-account key in the Firebase console:
# Project settings -> Service accounts -> Generate new private key. Save the
# downloaded JSON file somewhere on this machine (NOT in the repo) and point
# FIREBASE_SERVICE_ACCOUNT_JSON at its path. FIREBASE_PROJECT_ID is the
# Firebase project ID shown on that same page. Leave both unset to run with
# push disabled (a safe no-op, not an error).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOW_INSECURE_TEST_TOKENS=false

# Encrypts stored per-user AI provider API keys (see app/core/crypto.py).
# Must be a generated Fernet key, not a plain password — generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=replace-this-with-a-generated-fernet-key

AUTO_CREATE_SCHEMA=false
FAKE_WORKER_STEP_DELAY_SECONDS=0.35

# WORKER_ENGINE selects which runtime executes tasks: fake | codex | claude
WORKER_ENGINE=fake

CODEX_COMMAND=codex
# --sandbox workspace-write is required: without it, `codex exec` defaults to
# a read-only sandbox and silently self-reports "BLOCKED" instead of writing
# any files. Phodex's own approval gate (below) handles risky-command
# confirmation separately, so this only grants the write access codex needs.
CODEX_ARGS=exec --json --skip-git-repo-check --sandbox workspace-write -
CODEX_PROMPT_STDIN=true
CODEX_TIMEOUT_SECONDS=1800
CODEX_REQUIRE_INITIAL_APPROVAL=true
CODEX_INITIAL_APPROVAL_RISK_LEVEL=medium
CODEX_DEFAULT_WORKDIR=

CLAUDE_COMMAND=claude
CLAUDE_EXTRA_ARGS=
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_TIMEOUT_SECONDS=1800
CLAUDE_REQUIRE_INITIAL_APPROVAL=true
CLAUDE_INITIAL_APPROVAL_RISK_LEVEL=medium
CLAUDE_DEFAULT_WORKDIR=
