# Phodex Cloud runtime — the backend runs on a server with no laptop attached.
# Copy to .env (local) or set these as Fly secrets / [env] (see fly.toml).

APP_NAME=Phodex Cloud
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://phodex-amber.vercel.app

# Managed Postgres (e.g. Neon) and Redis (e.g. Upstash, rediss:// for TLS).
DATABASE_URL=postgresql+asyncpg://user:password@host/phodex?ssl=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://user:password@host/phodex?sslmode=require
REDIS_URL=rediss://default:password@host:6379/0
REDIS_EVENT_CHANNEL=phodex:task-events
CACHE_TTL_SECONDS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
TASK_RATE_LIMIT_PER_MINUTE=30
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080
MAX_ACTIVE_SESSIONS_PER_USER=10
# One task at a time per user keeps a shared demo machine predictable.
MAX_CONCURRENT_TASKS_PER_USER=1

# Real Google Sign-In (see README "Setting up real Google Sign-In").
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOW_INSECURE_TEST_TOKENS=false

# Encrypts per-user API keys and GitHub tokens at rest (Fernet key).
SETTINGS_ENCRYPTION_KEY=replace-this-with-a-generated-fernet-key

# The address the app should use; shown on /pair as a QR code too.
PUBLIC_BASE_URL=https://phodex-cloud.fly.dev

# --- Cloud runtime ---------------------------------------------------------
RUNTIME_MODE=cloud
WORKSPACES_ROOT=/srv/phodex/workspaces
CLOUD_RUNNER_NAME=Phodex Cloud
CLOUD_RUNNER_HEARTBEAT_SECONDS=30
# Server-wide fallback for cloning/pushing when a user stored no token of
# their own (fine-grained PAT, Contents: read/write on the demo repos only).
GITHUB_DEFAULT_TOKEN=
PHODEX_GIT_AUTHOR_NAME=Phodex Cloud
PHODEX_GIT_AUTHOR_EMAIL=phodex-cloud@users.noreply.github.com

# Public demo account (POST /auth/demo). Leave empty to disable.
DEMO_ACCOUNT_EMAIL=demo@phodex.dev
DEMO_ACCOUNT_PASSWORD=replace-with-a-long-random-password
DEMO_ACCOUNT_NAME=Phodex Demo
# The only repositories the demo account may connect (comma-separated).
DEMO_REPO_ALLOWLIST=https://github.com/GAURAV-1313/phodex-demo-playground

# --- Worker: Claude Code CLI ------------------------------------------------
WORKER_ENGINE=claude
CLAUDE_COMMAND=claude
CLAUDE_EXTRA_ARGS=
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_TIMEOUT_SECONDS=1800
CLAUDE_REQUIRE_INITIAL_APPROVAL=true
CLAUDE_INITIAL_APPROVAL_RISK_LEVEL=medium
CLAUDE_DEFAULT_WORKDIR=/srv/phodex/workspaces
# Server-wide Anthropic key used by the CLI unless the user stored their own
# key in the app (Account -> AI engine). Read by the CLI directly.
ANTHROPIC_API_KEY=sk-ant-...

# --- Worker: Anthropic Managed Agents (alternative to the CLI) -------------
# WORKER_ENGINE=managed
# Run `python3 scripts/setup_managed_agent.py` once and paste the IDs:
MANAGED_AGENT_ID=
MANAGED_ENVIRONMENT_ID=
MANAGED_TIMEOUT_SECONDS=1800
MANAGED_REQUIRE_INITIAL_APPROVAL=true
MANAGED_INITIAL_APPROVAL_RISK_LEVEL=medium

# Push notifications (optional, see README).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
