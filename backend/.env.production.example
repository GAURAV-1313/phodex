APP_NAME=Phodex Backend
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://phodex:replace-db-password@db-host:5432/phodex
ALEMBIC_DATABASE_URL=postgresql+psycopg://phodex:replace-db-password@db-host:5432/phodex
REDIS_URL=redis://redis-host:6379/0
REDIS_EVENT_CHANNEL=phodex:task-events
CACHE_TTL_SECONDS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
TASK_RATE_LIMIT_PER_MINUTE=30
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080
MAX_ACTIVE_SESSIONS_PER_USER=5
MAX_CONCURRENT_TASKS_PER_USER=5

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOW_INSECURE_TEST_TOKENS=false

AUTO_CREATE_SCHEMA=false
FAKE_WORKER_STEP_DELAY_SECONDS=0.35

WORKER_ENGINE=codex

CODEX_COMMAND=codex
# Optional runtime flags. If your runtime supports structured output, set flags here.
CODEX_ARGS=
CODEX_PROMPT_STDIN=true
CODEX_TIMEOUT_SECONDS=1800
CODEX_REQUIRE_INITIAL_APPROVAL=true
CODEX_INITIAL_APPROVAL_RISK_LEVEL=medium
CODEX_DEFAULT_WORKDIR=/srv/phodex/workspaces

# Alternative to WORKER_ENGINE=codex: runs tasks through the Claude Code CLI.
CLAUDE_COMMAND=claude
CLAUDE_EXTRA_ARGS=
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_TIMEOUT_SECONDS=1800
CLAUDE_REQUIRE_INITIAL_APPROVAL=true
CLAUDE_INITIAL_APPROVAL_RISK_LEVEL=medium
CLAUDE_DEFAULT_WORKDIR=/srv/phodex/workspaces
