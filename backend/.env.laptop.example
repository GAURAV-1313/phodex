APP_NAME=Phodex Backend
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

POSTGRES_IMAGE=arm64v8/postgres:16-alpine
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/phodex
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/phodex
REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_CHANNEL=phodex:task-events
CACHE_TTL_SECONDS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
TASK_RATE_LIMIT_PER_MINUTE=30
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

JWT_SECRET_KEY=local-laptop-dev-secret-change-before-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080
MAX_ACTIVE_SESSIONS_PER_USER=0
MAX_CONCURRENT_TASKS_PER_USER=3

GOOGLE_CLIENT_ID=
ALLOW_INSECURE_TEST_TOKENS=true

AUTO_CREATE_SCHEMA=false
FAKE_WORKER_STEP_DELAY_SECONDS=0.35

WORKER_ENGINE=codex

# Use the CLI installed by `npm install -g @openai/codex` on Apple Silicon.
CODEX_COMMAND=/opt/homebrew/bin/codex
# Keep the worker isolated from interactive MCP connectors. `--ignore-user-config`
# still uses the CLI login stored in CODEX_HOME.
CODEX_ARGS=exec --json --skip-git-repo-check --ignore-user-config -
CODEX_PROMPT_STDIN=true
CODEX_TIMEOUT_SECONDS=1800
CODEX_REQUIRE_INITIAL_APPROVAL=true
CODEX_INITIAL_APPROVAL_RISK_LEVEL=medium

# Point this to a disposable local repo/sandbox for real worker testing.
CODEX_DEFAULT_WORKDIR=/Users/gaurav/phodex

# Alternative to WORKER_ENGINE=codex: runs tasks through the Claude Code CLI
# (`claude -p ... --output-format stream-json`) instead. Requires `claude` on
# PATH and an authenticated session (`claude` login), same as the Codex CLI.
# CLAUDE_COMMAND=/opt/homebrew/bin/claude
CLAUDE_EXTRA_ARGS=
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_TIMEOUT_SECONDS=1800
CLAUDE_REQUIRE_INITIAL_APPROVAL=true
CLAUDE_INITIAL_APPROVAL_RISK_LEVEL=medium
CLAUDE_DEFAULT_WORKDIR=/Users/gaurav/phodex
